{
  "name": "hotel-vila-nova-principe",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare:public": "node build/prepare-public.mjs",
    "dev": "node build/prepare-public.mjs && vinext dev",
    "build": "node build/prepare-public.mjs && vinext build",
    "start": "vinext start",
    "sync:layout": "node build/sync-layout.mjs",
    "build:styles": "node build/compile-styles.mjs",
    "optimize:images": "node build/optimize-images.mjs",
    "check": "node build/sync-layout.mjs --check && node build/check-site.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "0.34.5",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
